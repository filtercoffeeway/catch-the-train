[Unit]
Description=Catch The Train BART Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
User=catchthetrain
Group=catchthetrain
Environment=DB_PATH=/var/lib/catchthetrain/catchthetrain.db
EnvironmentFile=/etc/catchthetrain/env
StateDirectory=catchthetrain
WorkingDirectory=/var/lib/catchthetrain
ExecStart=/opt/catchthetrain/.venv/bin/python -m catchthetrain
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
